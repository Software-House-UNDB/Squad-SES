generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  COORDENACAO_SES
  REPRESENTANTE_UNDB

  @@map("perfil")
}

enum StatusProcesso {
  rascunho
  enviado
  em_analise
  pendencia
  aprovado
  aguardando_assinaturas
  concluido

  @@map("status_processo")
}

enum TipoEstagio {
  obrigatorio
  pos_graduacao

  @@map("tipo_estagio")
}

enum TipoDocumento {
  oficio
  oficio_alteracao
  termo_compromisso
  kit_estagio
  anexo
  plano_atividades
  apolice
  lista_indicados
  documento_pessoal
  declaracao

  @@map("tipo_documento")
}

// Quem precisa assinar um documento (escopo P0: TCE e declarações).
// A Coordenação SES não assina.
enum PapelSignatario {
  REPRESENTANTE_UNDB
  SUPERVISOR
  DIRETOR_ESP
  ESTAGIARIO

  @@map("papel_signatario")
}

// SENHA: representante da UNDB, logado (RF-02).
// OTP: link único por e-mail + código de 6 dígitos (RF-04).
enum MetodoAssinatura {
  SENHA
  OTP

  @@map("metodo_assinatura")
}

// Lei 14.063/2020, art. 4º. O MVP só usa SIMPLES.
enum NivelAssinatura {
  SIMPLES
  AVANCADA
  QUALIFICADA

  @@map("nivel_assinatura")
}

// pendencia e observacao: coordenação SES. resposta: representante da UNDB (RF-12).
enum TipoComentario {
  pendencia
  observacao
  resposta

  @@map("tipo_comentario")
}

model Usuario {
  id           String      @id @default(uuid()) @db.Uuid
  nome         String
  email        String      @unique
  senhaHash    String      @map("senha_hash")
  perfil       Perfil
  instituicao  String?
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")
  processos    Processo[]
  documentos   Documento[]
  auditorias   Auditoria[]
  signatarios  Signatario[]
  comentarios  Comentario[]

  @@map("usuarios")
}

model Processo {
  id                String         @id @default(uuid()) @db.Uuid
  tipoEstagio       TipoEstagio?   @map("tipo_estagio")
  status            StatusProcesso @default(rascunho)
  observacaoAnalise String?        @map("observacao_analise")
  // Supervisor do campo de estágio. Opcionais no banco; obrigatórios antes
  // do envio para assinatura (regra na aplicação).
  supervisorNome    String?        @map("supervisor_nome")
  supervisorEmail   String?        @map("supervisor_email")
  criadoPorId       String         @map("criado_por_id") @db.Uuid
  criadoPor         Usuario        @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  criadoEm          DateTime       @default(now()) @map("criado_em")
  atualizadoEm      DateTime       @updatedAt @map("atualizado_em")
  estagiarios       Estagiario[]
  documentos        Documento[]
  comentarios       Comentario[]

  @@index([status])
  @@index([criadoPorId])
  @@map("processos")
}

model Estagiario {
  id              String      @id @default(uuid()) @db.Uuid
  processoId      String      @map("processo_id") @db.Uuid
  processo        Processo    @relation(fields: [processoId], references: [id], onDelete: Restrict)
  nome            String
  cpf             String      @db.Char(11)
  matricula       String
  curso           String
  // Opcional no banco; obrigatório antes do envio para assinatura.
  email           String?
  menorIdade      Boolean     @default(false) @map("menor_idade")
  responsavelNome String?     @map("responsavel_nome")
  cidade          String?
  uf              String?     @db.Char(2)
  cep             String?     @db.Char(8)
  tipoLiberacao   String?     @map("tipo_liberacao")
  periodo         Int?
  dataInicio      DateTime?   @map("data_inicio") @db.Date
  dataTermino     DateTime?   @map("data_termino") @db.Date
  horasPorDia     Int?        @map("horas_por_dia")
  diasSemana      String[]    @map("dias_semana")
  horarioInicio   String?     @map("horario_inicio") @db.Char(5)
  horarioFim      String?     @map("horario_fim") @db.Char(5)
  criadoEm        DateTime    @default(now()) @map("criado_em")
  atualizadoEm    DateTime    @updatedAt @map("atualizado_em")
  documentos      Documento[]
  signatarios     Signatario[]

  @@unique([processoId, cpf])
  @@unique([processoId, matricula])
  @@map("estagiarios")
}

model Documento {
  id           String        @id @default(uuid()) @db.Uuid
  processoId   String        @map("processo_id") @db.Uuid
  processo     Processo      @relation(fields: [processoId], references: [id], onDelete: Restrict)
  estagiarioId String?       @map("estagiario_id") @db.Uuid
  estagiario   Estagiario?   @relation(fields: [estagiarioId], references: [id], onDelete: Restrict)
  tipo         TipoDocumento
  nomeArquivo  String        @map("nome_arquivo")
  mimeType     String        @map("mime_type")
  tamanhoBytes Int           @map("tamanho_bytes")
  hashSha256   String        @map("hash_sha256") @db.Char(64)
  storageKey   String        @unique @map("storage_key")
  enviadoPorId String        @map("enviado_por_id") @db.Uuid
  enviadoPor   Usuario       @relation(fields: [enviadoPorId], references: [id], onDelete: Restrict)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  // Código público de validação (RF-17), gerado quando o documento vai para
  // assinatura: 12 caracteres em base32 de Crockford, guardados sem hífens.
  codigoValidacao String?    @unique @map("codigo_validacao") @db.Char(12)
  signatarios  Signatario[]
  assinaturas  Assinatura[]
  comentarios  Comentario[]

  // Mesmo PDF duas vezes no mesmo processo é reenvio. O índice também atende
  // às buscas por processo_id, por isso substitui o @@index([processoId]).
  @@unique([processoId, hashSha256], map: "documentos_processo_hash_unico")
  @@index([estagiarioId])
  @@index([enviadoPorId])
  @@map("documentos")
}

// Conversa da análise sobre um documento do processo (RF-12). Só se cria: não há
// edição nem exclusão, porque o comentário é parte do histórico da análise.
model Comentario {
  id          String         @id @default(uuid()) @db.Uuid
  processoId  String         @map("processo_id") @db.Uuid
  processo    Processo       @relation(fields: [processoId], references: [id], onDelete: Restrict)
  // Opcional, como no modelo do projeto. Se o documento for removido, o campo
  // fica nulo e o comentário segue como histórico do processo.
  documentoId String?        @map("documento_id") @db.Uuid
  documento   Documento?     @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  autorId     String         @map("autor_id") @db.Uuid
  autor       Usuario        @relation(fields: [autorId], references: [id], onDelete: Restrict)
  tipo        TipoComentario
  texto       String
  criadoEm    DateTime       @default(now()) @map("criado_em")

  @@index([processoId, criadoEm])
  @@index([documentoId, criadoEm])
  @@index([autorId])
  @@map("comentarios")
}

model Auditoria {
  id          String   @id @default(uuid()) @db.Uuid
  usuarioId   String?  @map("usuario_id") @db.Uuid
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  acao        String
  entidade    String
  entidadeId  String   @map("entidade_id")
  dadosAntes  Json?    @map("dados_antes")
  dadosDepois Json?    @map("dados_depois")
  ip          String?
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("auditoria")
}

// Uma linha por pessoa que precisa assinar o documento. Nome e e-mail são
// copiados no momento do envio, para a evidência não mudar se o cadastro mudar.
model Signatario {
  id           String          @id @default(uuid()) @db.Uuid
  documentoId  String          @map("documento_id") @db.Uuid
  documento    Documento       @relation(fields: [documentoId], references: [id], onDelete: Restrict)
  papel        PapelSignatario
  nome         String
  email        String
  // REPRESENTANTE_UNDB assina logado: aponta para o usuário.
  usuarioId    String?         @map("usuario_id") @db.Uuid
  usuario      Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  // ESTAGIARIO: aponta para o cadastro do estagiário.
  estagiarioId String?         @map("estagiario_id") @db.Uuid
  estagiario   Estagiario?     @relation(fields: [estagiarioId], references: [id], onDelete: Restrict)

  // Link único (RF-04). Só o hash SHA-256 do token fica no banco.
  // Reenviar o link troca o hash, o que invalida o link anterior.
  tokenHash     String?   @unique @map("token_hash") @db.Char(64)
  tokenExpiraEm DateTime? @map("token_expira_em") @db.Timestamptz(3)
  linkEnviadoEm DateTime? @map("link_enviado_em") @db.Timestamptz(3)

  // OTP de 6 dígitos enviado ao mesmo e-mail. Só o hash fica no banco.
  otpHash       String?   @map("otp_hash")
  otpExpiraEm   DateTime? @map("otp_expira_em") @db.Timestamptz(3)
  otpTentativas Int       @default(0) @map("otp_tentativas")

  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")
  assinatura   Assinatura?

  @@unique([documentoId, papel])
  @@index([usuarioId])
  @@index([estagiarioId])
  @@map("signatarios")
}

// Evidências do ato de assinar (RF-15, seção 8). Append-only: um trigger
// recusa UPDATE, DELETE e TRUNCATE, como na auditoria.
model Assinatura {
  id           String           @id @default(uuid()) @db.Uuid
  signatarioId String           @unique @map("signatario_id") @db.Uuid
  signatario   Signatario       @relation(fields: [signatarioId], references: [id], onDelete: Restrict)
  documentoId  String           @map("documento_id") @db.Uuid
  documento    Documento        @relation(fields: [documentoId], references: [id], onDelete: Restrict)
  // Hash do PDF calculado no ato da assinatura, não reaproveitado do upload.
  hashSha256   String           @map("hash_sha256") @db.Char(64)
  metodo       MetodoAssinatura
  nivel        NivelAssinatura  @default(SIMPLES)
  // Aceite explícito ("Li e concordo"). O CHECK no banco exige true.
  aceite       Boolean
  ip           String
  userAgent    String           @map("user_agent")
  // Timestamp do servidor, em UTC.
  assinadoEm   DateTime         @default(now()) @map("assinado_em") @db.Timestamptz(3)

  @@index([documentoId])
  @@map("assinaturas")
}
