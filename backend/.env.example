# Copie para backend/.env (local) e NUNCA commite o .env.
# Em produção (Render), cada variável é cadastrada em Environment do serviço, não por arquivo.
# Os valores abaixo são só para desenvolvimento local com o docker-compose.yml (npm run db:up).
#
# Legenda: [em uso] já lida pelo código; [previsto] ainda não lida, nome sugerido para quem implementar.

# --- Servidor ---------------------------------------------------------------
# [em uso] O Render injeta a PORT sozinho: não cadastrar lá.
PORT=3000
NODE_ENV=development

# --- Banco (PostgreSQL) -----------------------------------------------------
# [em uso] Local: Postgres do docker-compose.
# Render: string do Neon. Use a conexão com ?sslmode=require no final.
# Rodar `prisma migrate deploy` com a conexão DIRETA do Neon (sem "-pooler" no host).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ses_dev?schema=public"

# --- Autenticação JWT -------------------------------------------------------
# [previsto] Segredos diferentes para access e refresh. Gerar valores longos e aleatórios em produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-local-longo
JWT_REFRESH_SECRET=troque-por-outro-segredo-local-longo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Seed (usuários de teste) ----------------------------------------------
# [em uso] Senha dos usuários criados por `npm run seed --workspace=backend`
# (coordenacao@ses.ma.gov.br e representante@undb.edu.br). Só para dev/staging.
SEED_SENHA=Senha@2026

# --- CORS -------------------------------------------------------------------
# [previsto] Origem do frontend que pode chamar a API. Em produção: URL do Vercel (sem barra no final).
CORS_ORIGIN=http://localhost:5173

# --- Armazenamento de arquivos (API S3) -------------------------------------
# [em uso] Local: MinIO do docker-compose (console em http://localhost:9001).
# Produção: Backblaze B2 (compatível com S3). Endpoint no formato https://s3.<regiao>.backblazeb2.com,
# usando a Application Key (keyID + applicationKey) criada no painel do B2.
# Sem S3_REGION, S3_BUCKET e as chaves, a API sobe, mas as rotas de documentos respondem 503.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ses-docs
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true no MinIO local; false no Backblaze B2.
S3_FORCE_PATH_STYLE=true
